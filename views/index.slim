div class="title" 
    h1 Admin Page
    br
h1 ITEMS
-@itemsData.each do |items|
    p Namn: #{items["name"]}
    p Damage: #{items["damage"]}
    p Cost: #{items["cost"]}
    hr
a href="/protected/items/new" Lägg till ett nytt item 
br

/ h1 ENEMIES
-@enemiesData.each do |enemies|
    p Namn: #{enemies["name"]}
    p Damage: #{enemies["damage"]}
    p Type: #{enemies["type_id"]}
    p Health: #{enemies["health"]}
    p Id: #{enemies["id"]} 
    / a href="/enemies/#{enemies["id"]}/fight" Fight #{enemies["name"]} 

    br

br
h1 CHANGE ITEMS
-@itemsData.each do |items|
    p #{items["name"]}
    p Damage: #{items["damage"]}    
    h5 
        a href="/protected/items/#{items["id"]}/edit" Redigera #{items["name"]} 


    form action="/protected/items/#{items["id"]}/delete" method="post"
      input type="submit" value="Ta bort #{items["name"]}🔥🗑️"

    hr

    

